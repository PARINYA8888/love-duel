{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".write": "auth != null && !data.exists() && $code.matches(/^LD[A-HJ-NP-Z2-9]{6}$/) && newData.child('hostUid').val() === auth.uid && newData.hasChildren(['hostUid'])",
        "hostUid": {
          ".read": "auth != null && (data.val() === auth.uid || root.child('rooms').child($code).child('guestUid').val() === auth.uid || root.child('rooms').child($code).child('joinRequests').child(auth.uid).exists())"
        },
        "guestUid": {
          ".read": "auth != null && (root.child('rooms').child($code).child('hostUid').val() === auth.uid || data.val() === auth.uid || root.child('rooms').child($code).child('joinRequests').child(auth.uid).exists())",
          ".write": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid && (!newData.exists() || (newData.isString() && root.child('rooms').child($code).child('joinRequests').child(newData.val()).exists() && (!data.exists() || data.val() === newData.val())))"
        },
        "createdAt": {
          ".read": "auth != null && (root.child('rooms').child($code).child('hostUid').val() === auth.uid || root.child('rooms').child($code).child('guestUid').val() === auth.uid)"
        },
        "joinRequests": {
          ".read": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (root.child('rooms').child($code).child('hostUid').val() === auth.uid || auth.uid === $uid)",
            ".write": "auth != null && auth.uid === $uid && auth.uid !== root.child('rooms').child($code).child('hostUid').val() && root.child('rooms').child($code).child('hostUid').exists() && (!root.child('rooms').child($code).child('guestUid').exists() || root.child('rooms').child($code).child('guestUid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name', 'token']) && newData.child('name').isString() && newData.child('name').val().length <= 18 && newData.child('token').isString() && newData.child('token').val().length <= 128"
          }
        },
        "presence": {
          "$uid": {
            ".read": "auth != null && (root.child('rooms').child($code).child('hostUid').val() === auth.uid || root.child('rooms').child($code).child('guestUid').val() === auth.uid)",
            ".write": "auth != null && auth.uid === $uid && (auth.uid === root.child('rooms').child($code).child('hostUid').val() || auth.uid === root.child('rooms').child($code).child('guestUid').val())",
            ".validate": "newData.hasChildren(['online', 'updatedAt']) && newData.child('online').val() === true"
          }
        },
        "inbox": {
          "$recipientUid": {
            ".read": "auth != null && auth.uid === $recipientUid && (auth.uid === root.child('rooms').child($code).child('hostUid').val() || auth.uid === root.child('rooms').child($code).child('guestUid').val())",
            "$messageId": {
              ".write": "auth != null && ((!data.exists() && newData.hasChildren(['fromUid', 'message', 'sentAt']) && newData.child('fromUid').val() === auth.uid && ((auth.uid === root.child('rooms').child($code).child('hostUid').val() && $recipientUid === root.child('rooms').child($code).child('guestUid').val()) || (auth.uid === root.child('rooms').child($code).child('guestUid').val() && $recipientUid === root.child('rooms').child($code).child('hostUid').val()))) || (data.exists() && !newData.exists() && auth.uid === $recipientUid && (auth.uid === root.child('rooms').child($code).child('hostUid').val() || auth.uid === root.child('rooms').child($code).child('guestUid').val())))",
              ".validate": "!newData.exists() || (newData.child('message').child('type').isString() && newData.child('message').child('type').val().length <= 40)"
            }
          }
        }
      }
    }
  }
}

